<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base MatchOracle theme -->
    <style name="Theme.MatchOracle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/card_dark</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme (no action bar, full screen) -->
    <style name="Theme.MatchOracle.Splash" parent="Theme.MatchOracle">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
