<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for MatchOracle.
  Only HTTPS traffic is permitted; cleartext (HTTP) is blocked.
  The Railway production domain is explicitly trusted.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">matchoracle-production.up.railway.app</domain>
        <domain includeSubdomains="true">railway.app</domain>
    </domain-config>
</network-security-config>
